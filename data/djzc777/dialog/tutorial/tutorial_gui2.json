{
    "type": "multi_action",
    "pause": false,
    "title": {
        "translate": "djzc.dialog.tutorial_gui2.title",
        "fallback": "冬战成员用书",
        "color": "yellow",
        "bold": true,
        "hover_event": {
            "action": "show_text",
            "value": {
                "translate": "djzc.dialog.author_write",
                "fallback": "%1$s 编写",
                "with": [
                    {
                        "translate": "djzc.dialog.author1",
                        "fallback": "冬战制作组"
                    }
                ]
            }
        }
    },
    "body": [
        {
            "type": "plain_message",
            "width": 420,
            "contents": {
                "translate": "djzc.dialog.tutorial_gui2.body1",
                "fallback": "步话机可以向队友发送快捷消息；重新部署会让你回到配装处；中止音乐会关掉你的BGM"
            }
        }
    ],
    "columns": 3,
    "actions": [
        {
            "label": {
                "translate": "djzc.dialog.userbook.msg",
                "fallback": "转到步话机",
                "color": "gold",
                "underlined": true
            },
            "action": {
                "type": "show_dialog",
                "dialog": "djzc777:tutorial/tutorial_gui2"
            }
        },
        {
            "label": {
                "translate": "djzc.dialog.userbook.redeploy",
                "fallback": "重新部署",
                "color": "dark_gray"
            },
            "tooltip": {
                "translate": "djzc.dialog.userbook.redeploy.desc",
