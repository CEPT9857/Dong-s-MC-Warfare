            },
            "action": {
                "type": "show_dialog",
                "dialog": "djzc777:tutorial/tutorial_gui2"
            }
        },
        {
            "label": {
                "translate": "djzc.dialog.userbook.stop_music",
                "fallback": "中止音乐（仅个人）",
                "color": "gold"
            },
            "action": {
                "type": "show_dialog",
                "dialog": "djzc777:tutorial/tutorial_gui2"
            }
        }
    ],
    "exit_action": {
        "label": {
            "translate": "djzc.dialog.common.next",
            "fallback": "下一页",
            "color": "aqua"
        },
        "action": {
            "type": "show_dialog",
            "dialog": "djzc777:tutorial/tutorial_gui3"
        }
