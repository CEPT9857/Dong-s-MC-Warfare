{
    "type": "notice",
    "pause": false,
    "title": {
        "translate": "djzc777.dialog.tutorial_b.title",
        "fallback": "训练目标 · 寻找 B 点",
        "color": "yellow",
        "bold": true,
        "hover_event": {
            "action": "show_text",
            "value": {
                "translate": "djzc.dialog.author_write",
                "fallback": "%1$s 编写",
                "with": [
                    {
                        "translate": "djzc.dialog.author1",
                        "fallback": "冬战制作组"
                    }
                ]
            }
        }
    },
    "body": [
        {
            "type": "plain_message",
            "width": 420,
            "contents": {
                "translate": "djzc777.dialog.tutorial_b.body1",
                "fallback": "既然你已经来到了B点，说明你已经学会来到B点了。",
                "color": "yellow"
            }
        },
        {
            "type": "plain_message",
            "width": 420,
            "contents": {
                "translate": "djzc777.dialog.tutorial_b.body2",
                "fallback": "相信你已经注意到，每个点位上方都有悬浮文字。在真正的对局中，你还可以通过信标光柱寻找点位，并判断它被哪一方占领。"
            }
        }
    ],
    "action": {
        "label": {
            "translate": "djzc777.dialog.tutorial_b.dismiss",
            "fallback": "一键占领B点",
            "color": "green"
        },
        "action": {
            "type": "run_command",
            "command": "dialog clear @s"
        }
    }
}
