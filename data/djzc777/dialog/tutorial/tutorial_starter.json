{
    "type": "notice",
    "pause": false,
    "title": {
        "translate": "djzc.dialog.tutorial_starter.title",
        "fallback": "激活启动器",
        "color": "yellow",
        "bold": true,
        "hover_event": {
            "action": "show_text",
            "value": {
                "translate": "djzc.dialog.author_write",
                "fallback": "%1$s 编写",
                "with": [
                    {
                        "translate": "djzc.dialog.author1",
                        "fallback": "冬战制作组"
                    }
                ]
            }
        }
    },
    "body": [
        {
        "type": "plain_message",
        "contents":[
            {
                "text": "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",
                "font": "minecraft:default"
            },
            {
                "text": "\uE004",
                "font": "djzc444:djzc_illustration"
            }
        ],
        "width": 256
        },
        {
            "type": "plain_message",
            "width": 420,
            "contents": {
                "translate": "djzc.dialog.tutorial_starter.body1",
                "fallback": "对的对的，对着启动器按着%1$s不放就能激活启动器。",
                "color": "yellow",
                "with": [
                    {
                        "keybind": "key.use"
                    }
                ]
            }
        },
        {
            "type": "plain_message",
            "width": 420,
            "contents": {
                "translate": "djzc.dialog.tutorial_starter.body2",
                "fallback": "当然，分几次转动启动器上%1$s也是可以的",
                "with": [
                    {
                        "translate": "entity.minecraft.item_frame"
                    }
                ],
                "strikethrough": true
            }
        },
        {
            "type": "plain_message",
            "width": 420,
            "contents": {
                "translate": "djzc.dialog.tutorial_starter.body3",
                "fallback": "如果你找不到启动器，可以看看HUD上的定位栏，白色的点就是启动器。",
                "color": "white"
            }
        }
    ],
    "action": {
        "label": {
            "translate": "djzc.dialog.tutorial_starter.dismiss",
            "fallback": "进攻C点！",
            "color": "dark_red"
        },
        "action": {
            "type": "run_command",
            "command": "trigger djzc.option set 102"
        }
    }
}
