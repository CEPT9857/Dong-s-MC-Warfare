{
    "type": "notice",
    "pause": false,
    "title": {
        "translate": "djzc777.dialog.tutorial_starter.title",
        "fallback": "你是怎么学会激活启动器的",
        "color": "yellow",
        "bold": true,
        "hover_event": {
            "action": "show_text",
            "value": {
                "translate": "djzc.dialog.author_write",
                "fallback": "%1$s 编写",
                "with": [
                    {
                        "translate": "djzc.dialog.author1",
                        "fallback": "冬战制作组"
                    }
                ]
            }
        }
    },
    "body": [
        {
            "type": "plain_message",
            "width": 420,
            "contents": {
                "translate": "djzc777.dialog.tutorial_starter.body1",
                "fallback": "对的对的，对着启动器按着%1$s不放就能激活启动器。",
                "color": "yellow",
                "with": [
                    {
                        "keybind": "key.use"
                    }
                ]
            }
        },
        {
            "type": "plain_message",
            "width": 420,
            "contents": {
                "translate": "djzc777.dialog.tutorial_c.body2",
                "fallback": "如果你找不到启动器，可以看看HUD上的定位栏，白色的点就是启动器。",
                "color": "white"
            }
        }
    ],
    "action": {
        "label": {
            "translate": "djzc777.dialog.tutorial_starter.dismiss",
            "fallback": "进攻C点！",
            "color": "dark_red"
        },
        "action": {
            "type": "run_command",
            "command": "dialog clear @s"
        }
    }
}
