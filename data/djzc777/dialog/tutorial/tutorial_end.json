{
    "type": "multi_action",
    "pause": false,
    "title": {
        "translate": "djzc.dialog.tutorial_end.title",
        "fallback": "下一步？",
        "color": "yellow",
        "bold": true,
        "hover_event": {
            "action": "show_text",
            "value": {
                "translate": "djzc.dialog.author_write",
                "fallback": "%1$s 编写",
                "with": [
                    {
                        "translate": "djzc.dialog.author1",
                        "fallback": "冬战制作组"
                    }
                ]
            }
        }
    },
    "body": [
        {
            "type": "plain_message",
            "width": 440,
            "contents": {
                "translate": "djzc.dialog.tutorial_end.body1",
                "fallback": "基础教程到此结束。以后可以在冬季战场百科全书中重新打开新手教程。",
                "color": "yellow"
            }
        },
        {
            "type": "plain_message",
            "width": 440,
            "contents": {
                "translate": "djzc.dialog.tutorial_end.body2",
                "fallback": "我们还为冬战的其他机制设计了进阶教程，帮助你了解这个游戏。",
                "color": "white"
            }
        }
    ],
    "columns": 3,
    "actions": [
        {
            "label": {
                "translate": "djzc.dialog.tutorial_end.finish",
                "fallback": "无视风险，结束教程"
            },
            "action": {
                "type": "run_command",
                "command": "trigger djzc.option set 105"
            }
        },
        {
            "label": {
                "translate": "djzc.dialog.tutorial_end.advanced",
                "fallback": "学习进阶教程",
                "color": "green"
            },
            "action": {
                "type": "show_dialog",
                "dialog": "djzc777:tutorial/tutorial_advanced"
            }
        },
        {
            "label": {
                "translate": "djzc.dialog.tutorial_end.replay",
                "fallback": "重播新手教程",
                "color": "aqua"
            },
            "action": {
                "type": "show_dialog",
                "dialog": "djzc777:tutorial/root"
            }
        }
    ]
}
