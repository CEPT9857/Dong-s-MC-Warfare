{
    "type": "notice",
    "pause": false,
    "title": {
        "translate": "djzc.dialog.tutorial_a.title",
        "fallback": "记住，这是一个占点游戏",
        "color": "yellow",
        "bold": true,
        "hover_event": {
            "action": "show_text",
            "value": {
                "translate": "djzc.dialog.author_write",
                "fallback": "%1$s 编写",
                "with": [
                    {
                        "translate": "djzc.dialog.author1",
                        "fallback": "冬战制作组"
                    }
                ]
            }
        }
    },
    "body": [
        {
            "type": "plain_message",
            "width": 420,
            "contents": {
                "translate": "djzc.dialog.tutorial_a.body1",
                "fallback": "冬战本质上是一个占点游戏，只要把地图上所有带框的地方全部占下来，T队就赢了"
            }
        },
        {
            "type": "plain_message",
            "width": 420,
            "contents": {
                "translate": "djzc.dialog.tutorial_a.body2",
                "fallback": "为了节约你的时间，只需要按下方的按钮，就能一键占领该战区"
            }
        }
    ],
    "action": {
        "label": {
            "translate": "djzc.dialog.tutorial_a.dismiss",
            "fallback": "一键占领A点"
        },
        "action": {
            "type": "run_command",
            "command": "trigger djzc.option set 100"
        }
    }
}
