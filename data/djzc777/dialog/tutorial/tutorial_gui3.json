        "translate": "djzc.dialog.tutorial_gui3.title",
        "fallback": "冬战成员用书",
        "color": "yellow",
        "bold": true,
        "hover_event": {
            "action": "show_text",
            "value": {
                "translate": "djzc.dialog.author_write",
                "fallback": "%1$s 编写",
