{
    "type": "notice",
    "pause": false,
    "title": {
        "translate": "djzc.dialog.tutorial_win.title",
        "fallback": "占领D点",
        "color": "yellow",
        "bold": true,
        "hover_event": {
            "action": "show_text",
            "value": {
                "translate": "djzc.dialog.author_write",
                "fallback": "%1$s 编写",
                "with": [
                    {
                        "translate": "djzc.dialog.author1",
                        "fallback": "冬战制作组"
                    }
                ]
            }
        }
    },
    "body": [
        {
            "type": "plain_message",
            "width": 420,
            "contents": {
                "translate": "djzc.dialog.tutorial_win.body1",
                "fallback": "干得好！胜败乃兵家常事，这一次算你赢了！",
                "color": "yellow"
            }
        },
        {
            "type": "plain_message",
            "width": 420,
            "contents": {
                "translate": "djzc.dialog.tutorial_win.body2",
                "fallback": "接下来是认识《冬战成员用书》的环节",
                "color": "white"
            }
        }
    ],
    "action": {
        "label": {
            "translate": "djzc.dialog.tutorial_win.dismiss",
            "fallback": "进入配装教学"
        },
        "action": {
            "type": "run_command",
            "command": "trigger djzc.option set 104"
        }
    }
}
