{
    "type": "multi_action",
    "pause": false,
    "title": {
        "translate": "djzc.dialog.tutorial_gui1.title",
        "fallback": "冬战成员用书",
        "color": "yellow",
        "bold": true,
        "hover_event": {
            "action": "show_text",
            "value": {
                "translate": "djzc.dialog.author_write",
                "fallback": "%1$s 编写",
                "with": [
                    {
                        "translate": "djzc.dialog.author1",
                        "fallback": "冬战制作组"
                    }
                ]
            }
        }
    },
    "body": [
        {
            "type": "plain_message",
            "width": 420,
            "contents": {
                "translate": "djzc.dialog.tutorial_gui1.body1",
                "fallback": "加入 CT 或 T 是选择防守方或进攻方；兵种选择用于更换兵种与装备"
            }
        }
    ],
    "columns": 3,
    "actions": [
        {
            "label": {
                "translate": "djzc.dialog.userbook.join_ct",
                "fallback": "加入CT",
                "color": "blue",
                "underlined": true
            },
            "tooltip": {
                "translate": "djzc.dialog.userbook.join_ct.desc",
                "fallback": "冬季战场的防守方，阻止T方占领全部战区，坚持到时间结束即获胜。"
            },
            "action": {
                "type": "show_dialog",
                "dialog": "djzc777:tutorial/tutorial_gui1"
            }
        },
        {
            "label": {
                "translate": "djzc.dialog.userbook.join_t",
                "fallback": "加入T",
                "color": "red",
                "underlined": true
            },
            "tooltip": {
                "translate": "djzc.dialog.userbook.join_t.desc",
                "fallback": "冬季战场的进攻方，占领全部四个战区（A、B、C、D）即可获胜。"
            },
            "action": {
                "type": "show_dialog",
                "dialog": "djzc777:tutorial/tutorial_gui1"
            }
        },
        {
            "label": {
                "translate": "djzc.dialog.userbook.type_choose",
                "fallback": "兵种选择",
                "color": "gold",
                "underlined": true
            },
            "action": {
                "type": "show_dialog",
                "dialog": "djzc777:tutorial/tutorial_gui1"
            }
        }
    ],
    "exit_action": {
        "label": {
            "translate": "djzc.dialog.common.next",
            "fallback": "下一页",
            "color": "aqua"
        },
        "action": {
            "type": "show_dialog",
            "dialog": "djzc777:tutorial/tutorial_gui2"
        }
    }
}
