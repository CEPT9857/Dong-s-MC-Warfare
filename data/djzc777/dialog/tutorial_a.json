        "translate": "djzc777.dialog.tutorial_a.title",
        "fallback": "训练目标 · 占领 A 点",
        "color": "gold",
        "bold": true
    },
    "body": [
        {
            "type": "plain_message",
            "width": 420,
            "contents": {
                "translate": "djzc777.dialog.tutorial_a.body1",
